{
  "manifest_version": 2,
  "name": "DocuTranslate 中文翻译",
  "version": "1.4.4",
  "description": "右键 PDF 一键 DocuTranslate 中文翻译，译文 PDF 自动回填 Zotero 条目",
  "homepage_url": "https://github.com/blanlak/docutranslate-zotero",
  "author": "blanklan",
  "icons": {
    "48": "chrome/content/icons/icon.png",
    "96": "chrome/content/icons/icon.png"
  },
  "applications": {
    "zotero": {
      "id": "docutranslate-cn@blanklan",
      "strict_min_version": "6.999",
      "strict_max_version": "10.*.*",
      "update_url": "https://raw.githubusercontent.com/blanlak/docutranslate-zotero/main/update.json"
    }
  }
}